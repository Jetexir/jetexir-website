---
import {Icon} from "astro-icon/components";
import {PLUGIN_WORDPRESS_URL, PLUGIN_GITHUB_URL} from "../consts";

const {
    title = "Ready to enhance your WooCommerce store?",
    description = "Jetexir is free and open source. Download it from the WordPress repository or explore the source code on GitHub.",
    primaryLabel = "Download on WordPress.org",
    secondaryLabel = "View on GitHub",
} = Astro.props;
---

<div class="cta-band">
    <h2>{title}</h2>
    <p>{description}</p>
    <div class="cta-actions">
        <a href={PLUGIN_WORDPRESS_URL} target="_blank" rel="noopener" class="btn btn-light">
            <Icon name="wordpress" height="20" width="20"/> {primaryLabel}
        </a>
        <a href={PLUGIN_GITHUB_URL} target="_blank" rel="noopener" class="btn btn-outline">
            <Icon name="github-2" height="20" width="20"/> {secondaryLabel}
        </a>
    </div>
</div>

<style>
    .cta-band {
        padding: 3rem 2rem;
        border-radius: 24px;
        background: linear-gradient(135deg, #6d28d9 0%, #a855f7 100%);
        color: #fff;
        text-align: center;
    }

    .cta-band h2 {
        font-size: clamp(1.7rem, 3.5vw, 2.3rem);
        letter-spacing: -0.02em;
        margin: 0 0 0.8rem;
    }

    .cta-band p {
        max-width: 40rem;
        margin: 0 auto 1.6rem;
        color: rgba(255, 255, 255, 0.85);
        line-height: 1.7;
    }

    .cta-actions {
        display: flex;
        justify-content: center;
        gap: 0.9rem;
        flex-wrap: wrap;
    }
</style>
