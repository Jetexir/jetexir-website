---
import type {CollectionEntry} from "astro:content";

interface Props {
    post: CollectionEntry<'blog'>;
    headingLevel?: 'h2' | 'h3';
}

const {post, headingLevel = 'h3'} = Astro.props;
const formattedDate = post.data.date.toLocaleDateString('en-US', {year: 'numeric', month: 'long', day: 'numeric'});
const featured = `/images/featured/${post.id}.webp`;
---

<a href={`/blog/${post.id}`} class="post-card" data-astro-prefetch>
    <img class="featured" src={featured} alt="" width="1600" height="900" loading="lazy" decoding="async"/>
    <div class="post-body">
        <span class="post-date">{formattedDate}</span>
        {
            headingLevel === 'h2'
                    ? <h2 class="post-title">{post.data.title}</h2>
                    : <h3 class="post-title">{post.data.title}</h3>
        }
        <p class="post-description">{post.data.description}</p>
    </div>
    {
        post.data.tags && post.data.tags.length > 0 && (
                <div class="post-tags">
                    {post.data.tags.map((tag) => (
                            <span class="post-tag">{tag}</span>
                    ))}
                </div>
        )
    }
</a>

<style>
    .post-card {
        position: relative;
        display: flex;
        flex-direction: column;
        padding: 1.75rem 1.75rem 1.5rem;
        border-radius: 16px;
        border: 1px solid var(--border);
        background: var(--card-bg);
        transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    }

    .post-card:hover {
        transform: translateY(-4px);
        border-color: var(--primary);
        box-shadow: 0 18px 40px -18px rgba(124, 58, 237, 0.22);
    }

    .featured {
        display: block;
        width: calc(100% + 3.5rem);
        max-width: none;
        margin: -1.75rem -1.75rem 1.4rem;
        border-radius: 16px 16px 0 0;
        aspect-ratio: 16 / 9;
        object-fit: cover;
    }

    .post-date {
        display: inline-block;
        color: var(--primary);
        font-size: 0.82rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 0.6rem;
    }

    .post-title {
        font-size: 1.2rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        line-height: 1.4;
        margin: 0 0 0.5rem;
        color: var(--text);
    }

    .post-description {
        margin: 0;
        color: var(--text-muted);
        font-size: 0.9rem;
        line-height: 1.65;
        padding-right: 1.5rem;
    }

    .post-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-top: 1.25rem;
    }

    .post-tag {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        border-radius: 999px;
        border: 1px solid rgba(124, 58, 237, 0.25);
        background: rgba(124, 58, 237, 0.08);
        color: var(--primary);
        font-size: 0.78rem;
        font-weight: 600;
        line-height: 1.4;
    }

</style>
