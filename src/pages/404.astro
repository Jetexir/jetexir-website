---
import BaseLayout from "../layouts/BaseLayout.astro";
import {Icon} from "astro-icon/components";
---

<BaseLayout title='404 - Not Found' description='Page not found. Here are some helpful links.' current="404" robots="noindex, follow">
    <section class="page-hero">
        <div class="container">
            <h1 class="page-title">404</h1>
            <p class="page-subtitle">The page you are looking for does not exist.</p>
            <div class="about-actions">
                <a href="/" class="btn btn-primary">
                    <Icon name="arrow-left" height="20" width="20"/> Back to Home
                </a>
            </div>
        </div>
    </section>

    <!-- Agent-friendly navigation links -->
    <section class="container recovery-nav">
        <h2 class="recovery-title">Where to go next</h2>
        <div class="recovery-grid">
            <div class="recovery-card">
                <h3>Sitemap</h3>
                <p>Full list of all pages on this site.</p>
                <a href="/sitemap-index.xml">sitemap-index.xml</a>
            </div>
            <div class="recovery-card">
                <h3>Addons</h3>
                <p>Browse all 17 WooCommerce enhancement addons.</p>
                <a href="/addons">jetexir.ir/addons</a>
            </div>
            <div class="recovery-card">
                <h3>Blog</h3>
                <p>Product updates, guides, and release notes.</p>
                <a href="/blog">jetexir.ir/blog</a>
            </div>
            <div class="recovery-card">
                <h3>About</h3>
                <p>What Jetexir is and why it is open source.</p>
                <a href="/about">jetexir.ir/about</a>
            </div>
            <div class="recovery-card">
                <h3>Agent Guide</h3>
                <p>Machine-readable project description for AI agents.</p>
                <a href="/llms.txt">llms.txt</a>
            </div>
            <div class="recovery-card">
                <h3>Download</h3>
                <p>Install Jetexir from WordPress.org.</p>
                <a href="https://wordpress.org/plugins/jetexir/" target="_blank" rel="noopener">WordPress.org</a>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .page-hero {
        padding: 8rem 0 3rem;
        text-align: center;
    }

    .page-title {
        font-size: clamp(2.5rem, 6vw, 4rem);
        letter-spacing: -0.03em;
        margin: 0 0 1rem;
    }

    .page-subtitle {
        color: var(--text-muted);
        max-width: 34rem;
        margin: 0 auto 1.8rem;
        font-size: 1.05rem;
        line-height: 1.7;
    }

    .about-actions {
        display: flex;
        justify-content: center;
    }

    .recovery-nav {
        max-width: 56rem;
        padding-bottom: 5rem;
    }

    .recovery-title {
        text-align: center;
        font-size: 1.4rem;
        margin: 0 0 1.5rem;
        color: var(--text-muted);
    }

    .recovery-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
    }

    .recovery-card {
        padding: 1.25rem;
        border-radius: 12px;
        border: 1px solid var(--border);
        background: var(--card-bg);
    }

    .recovery-card h3 {
        font-size: 1rem;
        margin: 0 0 0.3rem;
    }

    .recovery-card p {
        color: var(--text-dim);
        font-size: 0.85rem;
        margin: 0 0 0.6rem;
        line-height: 1.5;
    }

    .recovery-card a {
        color: var(--primary);
        font-weight: 600;
        font-size: 0.9rem;
    }

    @media (max-width: 680px) {
        .recovery-grid {
            grid-template-columns: 1fr;
        }
    }
</style>