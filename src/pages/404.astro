---
import BaseLayout from "../layouts/BaseLayout.astro";
import {Icon} from "astro-icon/components";
---

<BaseLayout title='404 - Not Found' description='404 - Not Found' current="404" robots="noindex, follow">
    <section class="page-hero">
        <div class="container">
            <h1 class="page-title">404</h1>
            <p class="page-subtitle">Page not found. Redirecting you back to the homepage…</p>
            <div class="about-actions">
                <a href="/" class="btn btn-primary">
                    <Icon name="arrow-left" height="20" width="20"/> Back to Home
                </a>
            </div>
        </div>
    </section>

    <script>
      /*  setTimeout(function () {
            window.location.href = '/';
        }, 3000);*/
    </script>
</BaseLayout>

<style>
    .page-hero {
        padding: 8rem 0;
        text-align: center;
    }

    .page-title {
        font-size: clamp(2.5rem, 6vw, 4rem);
        letter-spacing: -0.03em;
        margin: 0 0 1rem;
    }

    .page-subtitle {
        color: var(--text-muted);
        max-width: 34rem;
        margin: 0 auto 1.8rem;
        font-size: 1.05rem;
        line-height: 1.7;
    }

    .about-actions {
        display: flex;
        justify-content: center;
    }
</style>