---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroBackground from "../components/HeroBackground.astro";
import CtaBand from "../components/CtaBand.astro";
import {Icon} from "astro-icon/components";

const cryptoAddresses = [
    {
        name: "Bitcoin (BTC)",
        address: "bc1qrts24tj0gemzkvewapcguvqdclttyr8amdp5xx",
        icon: "bitcoin"
    },
    {
        name: "Ethereum (ETH)",
        address: "0xCFdECBB34CF6226502c25f58378bd606133D6320",
        icon: "ethereum"
    },
    {
        name: "Solana (SOL)",
        address: "DDYFM8Ch7WmRfAGSM1AujTNpzmEtKo6YNS3eRsDQoUvL",
        icon: "solana"
    },
    {
        name: "BNB Smart Chain (BSC)",
        address: "0xCFdECBB34CF6226502c25f58378bd606133D6320",
        icon: "bnb"
    },
    {
        name: "Tron (TRX)",
        address: "TFQvPRHK7pnxckRieLMwvDAkd1w42W12kB",
        icon: "tron"
    },
    {
        name: "Dogecoin (DOGE)",
        address: "DAvJTqhq9a7uRmD1PTsueg8v9Nu5nZWC8Q",
        icon: "dogecoin"
    },
    {
        name: "XRP",
        address: "raN8etN1j8cmebepXmonboXppnwBy4seAW",
        icon: "xrp"
    }
];

const advantages = [
    {
        icon: "free",
        title: "Completely Free",
        description: "Jetexir is 100% free with no hidden fees, premium tiers, or paywalls. Every feature is available to every store from day one."
    },
    {
        icon: "open-source",
        title: "Open Source Transparency",
        description: "Full source code visibility means you can audit, modify, and trust the plugin running on your store."
    },
    {
        icon: "wordpress",
        title: "WordPress.org Verified",
        description: "Listed and reviewed on the official WordPress.org plugin repository, meeting strict quality and security standards."
    },
    {
        icon: "lightweight",
        title: "Lightweight & Fast",
        description: "Carefully optimized to add powerful features without bloating your store or slowing down page loads."
    },
    {
        icon: "no-code",
        title: "No-Code Configuration",
        description: "Every addon is fully configurable through the WordPress admin panel — no PHP, CSS, or JavaScript required."
    },
    {
        icon: "modular",
        title: "Modular Design",
        description: "Enable only the addons you need. Each one works independently, keeping your store lean and focused."
    }
];

const woocommerceBenefits = [
    {
        title: "Higher Conversion Rates",
        description: "Wishlists, product comparison, and sale progress bars help shoppers make decisions faster, reducing cart abandonment and increasing completed purchases.",
        stat: "Up to 35% more conversions",
        icon: "trending-up"
    },
    {
        title: "Better Customer Experience",
        description: "Fly Cart, Menu Cart, and streamlined checkout reduce friction at every step of the buying journey, keeping customers happy and engaged.",
        stat: "Smoother shopping flow",
        icon: "heart"
    },
    {
        title: "Increased Average Order Value",
        description: "Related products, quantity controls, and smart product displays encourage customers to add more items to their cart.",
        stat: "Higher cart values",
        icon: "dollar"
    },
    {
        title: "Enhanced Brand Trust",
        description: "Professional sale badges, custom order numbers, and branded announcement bars create a polished, trustworthy storefront.",
        stat: "Stronger brand presence",
        icon: "shield"
    },
    {
        title: "Reduced Support Tickets",
        description: "Product FAQs, clear pricing displays, and intuitive navigation help customers find answers independently, reducing support workload.",
        stat: "Fewer support queries",
        icon: "support"
    },
    {
        title: "Global Market Ready",
        description: "Multi-currency support, localized formatting, and flexible pricing options prepare your store for international customers.",
        stat: "Sell worldwide",
        icon: "globe"
